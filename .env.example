NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Push reminders. Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-site.example
# Server only. Used by the daily reminder job to read every user's reminders. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Optional AI helper (summaries, flashcards from notes)
ANTHROPIC_API_KEY=
